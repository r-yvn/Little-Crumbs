@inherits LayoutComponentBase

<div class="min-h-screen bg-[#F7F4EE] text-stone-800 flex flex-col font-sans">
    <!-- Sticky Boutique Header -->
    <header class="sticky top-0 z-50 bg-[#F7F4EE]/90 backdrop-blur-md border-b border-[#EBE3D5] px-6 sm:px-12 py-4 flex items-center justify-between shadow-sm">
        <!-- Clickable Logo & Brand Name on the Left -->
        <a href="/" style="text-decoration: none;" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center border border-amber-200 shadow-inner group-hover:scale-105 transition duration-300 text-lg">
                🥐
            </div>
            <span class="text-xl font-bold font-serif text-[#4A2E1B] tracking-tight">Little Crumbs</span>
        </a>

        <!-- Right-Aligned Navigation Links -->
        <nav class="flex items-center gap-6 sm:gap-8">
            <a href="/" style="text-decoration: none; color: #292524;" class="text-sm font-medium hover:text-[#4A2E1B] transition">
                Home
            </a>
            <a href="/our-story" style="text-decoration: none; color: #292524;" class="text-sm font-medium hover:text-[#4A2E1B] transition">
                Our Story
            </a>
            <a href="/catalog" style="text-decoration: none; color: #F7F4EE;" class="bg-[#4A2E1B] hover:bg-[#3B2414] text-sm font-semibold px-5 py-2.5 rounded-full shadow-sm transition transform hover:-translate-y-0.5">
                Browse Recipes
            </a>
        </nav>
    </header>

    <!-- Page Body Content -->
    <main class="flex-1">
        @Body
    </main>

    <!-- Footer -->
    <footer class="bg-[#4A2E1B] text-[#F7F4EE] py-8 text-center text-sm border-t border-[#5C3A21]">
        <p>&copy; 2026 Little Crumbs Artisan Bakery. Baked with love and C#.</p>
    </footer>
</div>