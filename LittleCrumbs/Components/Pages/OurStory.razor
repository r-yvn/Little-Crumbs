@page "/our-story"

<div class="min-h-screen bg-[#F7F4EE] text-stone-800 pb-16">
    <!-- Header Banner -->
    <div class="bg-[#4A2E1B] text-[#F7F4EE] py-16 px-6 sm:px-12 mb-12 text-center relative overflow-hidden">
        <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fde68a_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="max-w-3xl mx-auto relative z-10">
            <span class="inline-block bg-[#3B2414] text-amber-200 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-4 border border-[#5C3A21]">
                Established with Passion
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold font-serif mb-4">Our Sweet Journey</h1>
            <p class="text-amber-100 text-base sm:text-lg font-light">
                From a humble home oven to your digital cookbook companion—discover the heart behind Little Crumbs.
            </p>
        </div>
    </div>

    <!-- Main Content Section -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-white p-8 sm:p-12 rounded-3xl shadow-sm border border-[#EBE3D5] space-y-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                <div>
                    <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[#4A2E1B] mb-4">Baked Fresh, Shared with Love</h2>
                    <p class="text-stone-600 text-sm sm:text-base leading-relaxed mb-4">
                        Little Crumbs started as a quiet Sunday morning ritual—experimenting with sourdough starters, perfecting the golden lamination of butter croissants, and sharing warm chocolate chip cookies with neighbors.
                    </p>
                    <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
                        We believe that baking is more than just following measurements; it's an art form that brings people together around the kitchen table.
                    </p>
                </div>
                <div class="w-full aspect-square rounded-2xl overflow-hidden bg-amber-50 shadow-inner">
                    <img src="images/cake.jpg" alt="Baker crafting cakes" class="w-full h-full object-cover" />
                </div>
            </div>

            <hr class="border-[#EBE3D5]" />

            <!-- Core Values Grid -->
            <div>
                <h3 class="text-xl font-bold font-serif text-[#4A2E1B] text-center mb-8">What We Stand For</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    <div class="bg-amber-50/50 p-6 rounded-2xl border border-amber-100 text-center">
                        <div class="text-3xl mb-3">🌾</div>
                        <h4 class="font-bold text-[#4A2E1B] mb-1">Quality Ingredients</h4>
                        <p class="text-xs text-stone-600">Only real butter, premium chocolate, and freshly milled flours make the cut.</p>
                    </div>
                    <div class="bg-amber-50/50 p-6 rounded-2xl border border-amber-100 text-center">
                        <div class="text-3xl mb-3">📖</div>
                        <h4 class="font-bold text-[#4A2E1B] mb-1">Foolproof Guides</h4>
                        <p class="text-xs text-stone-600">Every recipe is rigorously tested so you can bake with complete confidence.</p>
                    </div>
                    <div class="bg-amber-50/50 p-6 rounded-2xl border border-amber-100 text-center">
                        <div class="text-3xl mb-3">❤️</div>
                        <h4 class="font-bold text-[#4A2E1B] mb-1">Community First</h4>
                        <p class="text-xs text-stone-600">Built by bakers, for bakers. We love seeing your kitchen creations come to life.</p>
                    </div>
                </div>
            </div>

            <!-- Call to Action -->
            <div class="text-center pt-4">
                <a href="/catalog" style="text-decoration: none; color: #F7F4EE;" class="bg-[#4A2E1B] hover:bg-[#3B2414] text-sm font-semibold px-5 py-2.5 rounded-full shadow-sm transition transform hover:-translate-y-0.5">
                    Explore Our Recipes &rarr;
                </a>
            </div>
        </div>
    </div>
</div> 