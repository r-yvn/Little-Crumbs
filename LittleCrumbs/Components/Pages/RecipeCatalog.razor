@page "/catalog"
@rendermode InteractiveServer
@using LittleCrumbs.Models
@using LittleCrumbs.Services
@inject RecipeService RecipeService
@inject NavigationManager Navigation

<div class="min-h-screen bg-amber-50/50 text-stone-800 pb-16">
    <!-- Header Banner -->
    <div class="relative bg-[#4A2E1B] text-[#F7F4EE] py-12 px-6 sm:px-12 mb-8 overflow-hidden">
        <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fde68a_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="max-w-6xl mx-auto relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-3xl sm:text-4xl font-extrabold font-serif mb-2">The Digital Bakery Cookbook</h1>
                <p class="text-amber-200 text-sm sm:text-base">Search, create, and manage your sweet recipes directly in Supabase.</p>
            </div>
            <button type="button"
                    @onclick="OpenAddModal"
                    class="bg-[#FFC634] hover:bg-amber-400 text-stone-950 font-bold px-5 py-3 rounded-xl shadow-sm transition text-sm cursor-pointer self-start sm:self-auto">
                + Add New Recipe
            </button>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <!-- Search & Filter Controls -->
        <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-amber-100 mb-8 flex flex-col sm:flex-row gap-4 items-center justify-between">
            <div class="w-full sm:w-96 relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-stone-400">🔍</span>
                <input type="text"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       placeholder="Search treat title (e.g., matcha, croissant)..."
                       class="w-full pl-10 pr-4 py-2.5 bg-amber-50/40 border border-amber-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm" />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto overflow-x-auto pb-2 sm:pb-0">
                @foreach (var cat in filterCategories)
                {
                    <button type="button"
                            @onclick="() => selectedCategory = cat"
                            class="px-4 py-2 rounded-xl text-sm font-medium transition whitespace-nowrap cursor-pointer @(selectedCategory.Equals(cat, StringComparison.OrdinalIgnoreCase) ? "bg-amber-800 text-white shadow-sm" : "bg-amber-50 text-amber-900 hover:bg-amber-100")">
                        @cat
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="mb-6 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm flex items-center justify-between">
                <span>@statusMessage</span>
                <button type="button" @onclick='() => statusMessage = ""' class="text-xs font-bold ml-4 cursor-pointer">✕</button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-16 text-stone-500">Loading recipes from Supabase...</div>
        }
        else
        {
            <!-- Recipe Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var recipe in FilteredRecipes)
                {
                    <div class="bg-white rounded-2xl shadow-sm border border-amber-100 overflow-hidden hover:shadow-md transition group flex flex-col">
                        <div class="w-full aspect-square bg-amber-100 relative overflow-hidden">
                            <img src="@recipe.ImageUrl" alt="@recipe.Title" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                            @if (recipe.IsFeatured)
                            {
                                <span class="absolute top-3 left-3 bg-amber-500 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
                                    ★ Featured
                                </span>
                            }
                            <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm text-amber-900 text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
                                @recipe.Category
                            </span>
                        </div>

                        <div class="p-6 flex-1 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between text-xs text-stone-500 mb-2">
                                    <span>⭐ @recipe.Rating.ToString("0.0") (@recipe.ReviewCount)</span>
                                    <span>🍽️ @recipe.Servings @(recipe.Servings == 1 ? "serving" : "servings")</span>
                                </div>
                                <div class="flex items-center gap-3 text-xs text-stone-500 mb-3">
                                    <span>Prep: @(recipe.PrepTimeMinutes)m</span>
                                    <span>•</span>
                                    <span>Bake: @(recipe.BakeTimeMinutes)m</span>
                                </div>
                                <h3 class="text-xl font-bold text-stone-900 group-hover:text-amber-800 transition mb-2 font-serif">
                                    @recipe.Title
                                </h3>
                                <p class="text-stone-600 text-sm line-clamp-2 mb-4">
                                    @recipe.Description
                                </p>
                            </div>

                            <div class="space-y-2">
                                <a href="/recipe/@recipe.Id" style="text-decoration: none; color: #78350f;" class="w-full text-center bg-amber-50 hover:bg-amber-100 font-medium py-2.5 rounded-xl transition text-sm block">
                                    Start Baking
                                </a>
                                <div class="grid grid-cols-2 gap-2">
                                    <button type="button"
                                            @onclick="() => OpenEditModal(recipe)"
                                            class="py-2 rounded-xl text-xs font-semibold bg-stone-100 hover:bg-stone-200 text-stone-700 transition cursor-pointer">
                                        ✏️ Edit
                                    </button>
                                    <button type="button"
                                            @onclick="() => DeleteRecipe(recipe.Id)"
                                            class="py-2 rounded-xl text-xs font-semibold bg-rose-50 hover:bg-rose-100 text-rose-700 transition cursor-pointer">
                                        🗑️ Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Add / Edit Recipe Modal -->
    @if (showFormModal)
    {
        <div class="fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4 overflow-y-auto">
            <div class="bg-white rounded-2xl max-w-2xl w-full p-6 sm:p-8 shadow-xl border border-amber-200 max-h-[90vh] overflow-y-auto">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold font-serif text-stone-900">
                        @(isEditing ? "Edit Recipe" : "Add New Recipe")
                    </h2>
                    <button type="button" @onclick="CloseModal" class="text-stone-400 hover:text-stone-700 text-lg font-bold cursor-pointer">✕</button>
                </div>

                <div class="space-y-4 text-sm">
                    <div>
                        <label class="block font-semibold text-stone-700 mb-1">Title</label>
                        <input @bind="formRecipe.Title" class="w-full px-3 py-2 border border-amber-200 rounded-xl" placeholder="e.g., Ube Pandesal" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold text-stone-700 mb-1">Category</label>
                            <select @bind="formRecipe.Category" class="w-full px-3 py-2 border border-amber-200 rounded-xl bg-white">
                                <option value="Cakes">Cakes</option>
                                <option value="Pastries">Pastries</option>
                                <option value="Cookies">Cookies</option>
                                <option value="Breads">Breads</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-semibold text-stone-700 mb-1">Image URL</label>
                            <input @bind="formRecipe.ImageUrl" class="w-full px-3 py-2 border border-amber-200 rounded-xl" placeholder="images/treat.jpg" />
                        </div>
                    </div>

                    <div>
                        <label class="block font-semibold text-stone-700 mb-1">Description</label>
                        <textarea @bind="formRecipe.Description" rows="2" class="w-full px-3 py-2 border border-amber-200 rounded-xl"></textarea>
                    </div>

                    <div class="grid grid-cols-3 gap-4">
                        <div>
                            <label class="block font-semibold text-stone-700 mb-1">Prep (mins)</label>
                            <input type="number" min="0" @bind="formRecipe.PrepTimeMinutes" class="w-full px-3 py-2 border border-amber-200 rounded-xl" />
                        </div>
                        <div>
                            <label class="block font-semibold text-stone-700 mb-1">Bake (mins)</label>
                            <input type="number" min="0" @bind="formRecipe.BakeTimeMinutes" class="w-full px-3 py-2 border border-amber-200 rounded-xl" />
                        </div>
                        <div>
                            <label class="block font-semibold text-stone-700 mb-1">Servings</label>
                            <input type="number" min="1" @bind="formRecipe.Servings" class="w-full px-3 py-2 border border-amber-200 rounded-xl" />
                        </div>
                    </div>

                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" @bind="formRecipe.IsFeatured" class="rounded" />
                        <span class="font-medium text-stone-700">Feature this recipe on the homepage</span>
                    </label>

                    @if (!isEditing)
                    {
                        <!-- Ingredients Builder -->
                        <div class="border-t border-amber-100 pt-4">
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-stone-800">Ingredients</span>
                                <button type="button" @onclick="AddIngredientRow" class="text-xs bg-amber-100 text-amber-900 px-3 py-1 rounded-lg font-semibold cursor-pointer">+ Add Ingredient</button>
                            </div>
                            @foreach (var ing in formRecipe.Ingredients)
                            {
                                <div class="grid grid-cols-5 gap-2 mb-2">
                                    <input @bind="ing.Amount" placeholder="Amount (e.g. 2 cups)" class="col-span-2 px-3 py-1.5 border border-amber-200 rounded-lg" />
                                    <input @bind="ing.Name" placeholder="Ingredient name" class="col-span-3 px-3 py-1.5 border border-amber-200 rounded-lg" />
                                </div>
                            }
                        </div>

                        <!-- Baking Steps Builder -->
                        <div class="border-t border-amber-100 pt-4">
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-stone-800">Baking Steps</span>
                                <button type="button" @onclick="AddStepRow" class="text-xs bg-amber-100 text-amber-900 px-3 py-1 rounded-lg font-semibold cursor-pointer">+ Add Step</button>
                            </div>
                            @foreach (var step in formRecipe.Steps)
                            {
                                <div class="space-y-1.5 mb-3 p-3 bg-amber-50/50 rounded-xl">
                                    <input @bind="step.Title" placeholder="Step title (e.g., Mix Dough)" class="w-full px-3 py-1.5 border border-amber-200 rounded-lg bg-white" />
                                    <textarea @bind="step.Instruction" rows="2" placeholder="Step instructions..." class="w-full px-3 py-1.5 border border-amber-200 rounded-lg bg-white"></textarea>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mt-6 flex justify-end gap-3">
                    <button type="button" @onclick="CloseModal" class="px-4 py-2 rounded-xl bg-stone-100 text-stone-700 font-medium text-sm cursor-pointer">Cancel</button>
                    <button type="button" @onclick="SaveRecipe" disabled="@isSaving" class="px-5 py-2 rounded-xl bg-amber-800 hover:bg-amber-900 text-white font-semibold text-sm cursor-pointer">
                        @(isSaving ? "Saving..." : (isEditing ? "Save Changes" : "Create Recipe"))
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<RecipeModel> allRecipes = new();
    private string searchQuery = "";
    private string selectedCategory = "All";
    private List<string> filterCategories = new() { "All", "Cakes", "Pastries", "Cookies", "Breads" };

    private bool isLoading = true;
    private bool isSaving = false;
    private bool showFormModal = false;
    private bool isEditing = false;
    private string statusMessage = "";
    private RecipeModel formRecipe = new();

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("category", out var categoryParam)
            && !string.IsNullOrEmpty(categoryParam))
        {
            selectedCategory = categoryParam!;
        }

        await LoadRecipesAsync();
    }

    private async Task LoadRecipesAsync()
    {
        isLoading = true;
        allRecipes = await RecipeService.GetAllRecipesAsync();
        isLoading = false;
    }

    private void OpenAddModal()
    {
        isEditing = false;
        formRecipe = new RecipeModel
        {
            Category = "Cakes",
            ImageUrl = "images/Strawberry Matcha Layer Cake.jpg",
            Servings = 8,
            Ingredients = new() { new IngredientItem() },
            Steps = new() { new BakingStepItem { Number = 1 } }
        };
        showFormModal = true;
    }

    private void OpenEditModal(RecipeModel recipe)
    {
        isEditing = true;
        formRecipe = new RecipeModel
        {
            Id = recipe.Id,
            Title = recipe.Title,
            Description = recipe.Description,
            Category = recipe.Category,
            ImageUrl = recipe.ImageUrl,
            PrepTimeMinutes = recipe.PrepTimeMinutes,
            BakeTimeMinutes = recipe.BakeTimeMinutes,
            Servings = recipe.Servings,
            Rating = recipe.Rating,
            ReviewCount = recipe.ReviewCount,
            IsFeatured = recipe.IsFeatured
        };
        showFormModal = true;
    }

    private void CloseModal() => showFormModal = false;

    private void AddIngredientRow() => formRecipe.Ingredients.Add(new IngredientItem());

    private void AddStepRow() => formRecipe.Steps.Add(new BakingStepItem { Number = formRecipe.Steps.Count + 1 });

    private async Task SaveRecipe()
    {
        if (string.IsNullOrWhiteSpace(formRecipe.Title)) return;

        isSaving = true;
        formRecipe.Ingredients = formRecipe.Ingredients.Where(i => !string.IsNullOrWhiteSpace(i.Name)).ToList();
        formRecipe.Steps = formRecipe.Steps.Where(s => !string.IsNullOrWhiteSpace(s.Title) || !string.IsNullOrWhiteSpace(s.Instruction)).ToList();

        if (isEditing)
        {
            await RecipeService.UpdateRecipeAsync(formRecipe);
            statusMessage = $"Updated \"{formRecipe.Title}\" in Supabase.";
        }
        else
        {
            await RecipeService.AddRecipeAsync(formRecipe);
            statusMessage = $"Added \"{formRecipe.Title}\" to Supabase.";
        }

        isSaving = false;
        showFormModal = false;
        await LoadRecipesAsync();
    }

    private async Task DeleteRecipe(int id)
    {
        await RecipeService.DeleteRecipeAsync(id);
        statusMessage = "Recipe deleted from Supabase.";
        await LoadRecipesAsync();
    }

    private IEnumerable<RecipeModel> FilteredRecipes => allRecipes.Where(r =>
        (selectedCategory.Equals("All", StringComparison.OrdinalIgnoreCase) || r.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(searchQuery) || r.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
    );
}