@page "/catalog"
@rendermode InteractiveServer
@using LittleCrumbs.Models
@inject NavigationManager Navigation

<div class="min-h-screen bg-amber-50/50 text-stone-800 pb-16">
    <!-- Header Banner -->
    
    <div class="relative bg-[#4A2E1B] text-[#F7F4EE] py-12 px-6 sm:px-12 mb-8 overflow-hidden">
        <!-- Dotted Overlay Pattern -->
        <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fde68a_1px,transparent_1px)] [background-size:16px_16px]"></div>
        
        <!-- Content Container -->
        <div class="max-w-6xl mx-auto relative z-10">
            <h1 class="text-3xl sm:text-4xl font-extrabold font-serif mb-2">The Digital Bakery Cookbook</h1>
            <p class="text-amber-200 text-sm sm:text-base">Search through our full collection of sweet recipes and baking guides.</p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <!-- Search & Filter Controls -->
        <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-amber-100 mb-8 flex flex-col sm:flex-row gap-4 items-center justify-between">
            <!-- Search Bar with Live Filter Binding -->
            <div class="w-full sm:w-96 relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-stone-400">🔍</span>
                <input type="text" 
                       @bind="searchQuery" 
                       @bind:event="oninput" 
                       placeholder="Search treat or description (e.g., matcha, croissant)..." 
                       class="w-full pl-10 pr-4 py-2.5 bg-amber-50/40 border border-amber-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm" />
            </div>

            <!-- Filter Buttons -->
            <div class="flex items-center gap-2 w-full sm:w-auto overflow-x-auto pb-2 sm:pb-0">
                @foreach (var cat in filterCategories)
                {
                    <button type="button"
                            @onclick="() => SetCategory(cat)" 
                            class="px-4 py-2 rounded-xl text-sm font-medium transition whitespace-nowrap cursor-pointer @(selectedCategory.Equals(cat, StringComparison.OrdinalIgnoreCase) ? "bg-amber-800 text-white shadow-sm" : "bg-amber-50 text-amber-900 hover:bg-amber-100")">
                        @cat
                    </button>
                }
            </div>
        </div>

        <!-- Recipe Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var recipe in FilteredRecipes)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-amber-100 overflow-hidden hover:shadow-md transition group flex flex-col">
                    <div class="w-full aspect-square bg-amber-100 relative overflow-hidden">
                        <img src="@recipe.ImageUrl" alt="@recipe.Title" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                        <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm text-amber-900 text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
                            @recipe.Category
                        </span>
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between text-xs text-stone-500 mb-2">
                                <span>⏱️ @recipe.PrepTimeMinutes mins</span>
                                <span>⭐ @recipe.Rating (@recipe.ReviewCount)</span>
                            </div>
                            <h3 class="text-xl font-bold text-stone-900 group-hover:text-amber-800 transition mb-2 font-serif">
                                @recipe.Title
                            </h3>
                            <p class="text-stone-600 text-sm line-clamp-2 mb-4">
                                @recipe.Description
                            </p>
                        </div>
                        <a href="/recipe/@recipe.Id" style="text-decoration: none; color: #78350f;" class="w-full text-center bg-amber-50 hover:bg-amber-100 font-medium py-2.5 rounded-xl transition text-sm block">
                            Start Baking
                        </a>
                    </div>
                </div>
            }
        </div>

        @if (!FilteredRecipes.Any())
        {
            <div class="text-center py-16 bg-white rounded-2xl border border-amber-100 shadow-sm mt-4">
                <div class="text-4xl mb-3">🥐</div>
                <h3 class="text-lg font-bold text-stone-800 font-serif">No sweet treats found</h3>
                <p class="text-sm text-stone-500 mt-1 mb-4">Try adjusting your search query or category filter.</p>
                <button type="button" @onclick="ClearFilters" class="text-xs bg-amber-100 text-amber-900 font-semibold px-4 py-2 rounded-xl hover:bg-amber-200 transition">
                    Reset Filters
                </button>
            </div>
        }
    </div>
</div>

@code {
    private string searchQuery = "";
    private string selectedCategory = "All";

    private List<string> filterCategories = new() { "All", "Cakes", "Pastries", "Cookies" };

    private List<RecipeModel> allRecipes = new()
    {
        new RecipeModel { Id = 1, Title = "Strawberry Matcha Layer Cake", Description = "A delightful fusion of earthy Japanese matcha sponge and sweet fresh strawberry cream filling.", Category = "Cakes", ImageUrl = "images/Strawberry Matcha Layer Cake.jpg", PrepTimeMinutes = 45, Rating = 4.9, ReviewCount = 38 },
        new RecipeModel { Id = 2, Title = "Flaky Butter Croissants", Description = "Master the art of lamination with golden, crispy layers of buttery pastry perfection.", Category = "Pastries", ImageUrl = "images/Flaky Butter Croissants.jpeg", PrepTimeMinutes = 180, Rating = 4.8, ReviewCount = 24 },
        new RecipeModel { Id = 3, Title = "Chunky Chocolate Chip Cookies", Description = "Crispy on the outside, gooey on the inside with pools of dark chocolate chunks.", Category = "Cookies", ImageUrl = "images/Chunky Chocolate Chip Cookies.jpg", PrepTimeMinutes = 25, Rating = 5.0, ReviewCount = 56 },
        new RecipeModel { Id = 4, Title = "Classic Cinnamon Rolls", Description = "Soft, fluffy dough swirled with rich cinnamon brown sugar and topped with cream cheese glaze.", Category = "Pastries", ImageUrl = "images/Classic Cinnamon Rolls.jpg", PrepTimeMinutes = 90, Rating = 4.9, ReviewCount = 42 },
        new RecipeModel { Id = 5, Title = "Lemon Raspberry Tart", Description = "Zesty lemon curd paired with tart fresh raspberries in a buttery shortcrust pastry shell.", Category = "Cakes", ImageUrl = "images/Lemon Raspberry Tart.jpg", PrepTimeMinutes = 60, Rating = 4.7, ReviewCount = 19 },
        new RecipeModel { Id = 6, Title = "Double Fudge Brownies", Description = "Rich, dense, and deeply chocolatey fudge squares topped with flaky sea salt.", Category = "Cookies", ImageUrl = "images/Double Fudge Brownies.jpg", PrepTimeMinutes = 35, Rating = 4.9, ReviewCount = 61 }
    };

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("category", out var categoryParam))
        {
            if (!string.IsNullOrEmpty(categoryParam))
            {
                selectedCategory = categoryParam!;
            }
        }
    }

    private void SetCategory(string category)
    {
        selectedCategory = category;
    }

    private void ClearFilters()
    {
        searchQuery = "";
        selectedCategory = "All";
    }

    private IEnumerable<RecipeModel> FilteredRecipes => allRecipes.Where(r => 
        (selectedCategory.Equals("All", StringComparison.OrdinalIgnoreCase) || r.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(searchQuery) || r.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
    );
}