@page "/recipe/{Id:int}"
@rendermode InteractiveServer
@using LittleCrumbs.Models
@using LittleCrumbs.Services
@inject RecipeService RecipeService

<div class="min-h-screen bg-amber-50/50 text-stone-800 pb-16">
    <!-- Back Navigation Bar -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 mb-6">
        <a href="/catalog" style="text-decoration: none; color: #F7F4EE;" class="bg-[#4A2E1B] hover:bg-[#3B2414] text-sm font-semibold px-5 py-2.5 rounded-full shadow-sm transition transform hover:-translate-y-0.5 inline-block">
            &larr; Back to Cookbook
        </a>
    </div>

    <!-- Recipe Detail Container -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
        @if (recipe == null)
        {
            <div class="text-center py-20 bg-white rounded-2xl border border-amber-100 shadow-sm">
                <div class="text-4xl mb-3">🥐</div>
                <h3 class="text-xl font-bold font-serif text-stone-800">Recipe not found</h3>
                <p class="text-sm text-stone-500 mt-1 mb-6">The sweet treat you are looking for does not exist or has been removed.</p>
                <a href="/catalog" style="text-decoration: none;" class="bg-amber-800 text-white font-medium px-6 py-2.5 rounded-xl text-sm transition inline-block">
                    Browse All Recipes
                </a>
            </div>
        }
        else
        {
            <!-- Header Card with Real Image -->
            <div class="bg-white rounded-3xl shadow-sm border border-amber-100 overflow-hidden mb-8">
                <div class="w-full h-72 sm:h-96 relative overflow-hidden bg-amber-100">
                    <img src="@recipe.ImageUrl" alt="@recipe.Title" class="w-full h-full object-cover" />
                    <span class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm text-amber-900 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
                        @recipe.Category
                    </span>
                </div>
                <div class="p-6 sm:p-10">
                    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                        <div class="flex items-center gap-4 text-xs sm:text-sm text-stone-500">
                            <span>⏱️ Prep: @recipe.PrepTimeMinutes mins</span>
                            <span>🔥 Bake: @recipe.BakeTimeMinutes mins</span>
                            <span>🍽️ Servings: @recipe.Servings</span>
                        </div>
                        <div class="flex items-center gap-1 text-sm font-semibold text-amber-800 bg-amber-50 px-3 py-1 rounded-xl">
                            ⭐ @recipe.Rating <span class="text-stone-500 font-normal">(@recipe.ReviewCount reviews)</span>
                        </div>
                    </div>

                    <h1 class="text-3xl sm:text-4xl font-extrabold font-serif text-amber-950 mb-3">@recipe.Title</h1>
                    <p class="text-stone-600 text-base leading-relaxed">@recipe.Description</p>
                </div>
            </div>

            <!-- Content Grid: Ingredients & Steps -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Ingredients Sidebar -->
                <div class="md:col-span-1 bg-white p-6 rounded-3xl shadow-sm border border-amber-100 h-fit">
                    <h2 class="text-xl font-bold font-serif text-amber-950 mb-4 flex items-center gap-2">
                        <span>📝</span> Ingredients
                    </h2>
                    <ul class="space-y-3 text-sm text-stone-700">
                        @foreach (var ing in recipe.Ingredients)
                        {
                            <li class="flex items-start gap-2.5 pb-2 border-b border-amber-50 last:border-0">
                                <input type="checkbox" @bind="ing.IsChecked" class="mt-1 rounded border-amber-300 text-amber-800 focus:ring-amber-500" />
                                <span><strong class="text-stone-900">@ing.Amount</strong> @ing.Name</span>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Baking Instructions Main Column -->
                <div class="md:col-span-2 bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-amber-100">
                    <h2 class="text-xl font-bold font-serif text-amber-950 mb-6 flex items-center gap-2">
                        <span>👩‍🍳</span> Baking Instructions
                    </h2>
                    <div class="space-y-6">
                        @foreach (var step in recipe.Steps)
                        {
                            <div class="flex gap-4 items-start">
                                <div class="bg-amber-800 text-white font-bold text-sm w-8 h-8 rounded-full flex items-center justify-center shrink-0 shadow-sm">
                                    @step.Number
                                </div>
                                <div>
                                    <h3 class="font-bold text-stone-900 text-base mb-1">@step.Title</h3>
                                    <p class="text-stone-600 text-sm leading-relaxed">@step.Instruction</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private RecipeModel? recipe;

    protected override void OnParametersSet()
    {
        recipe = RecipeService.GetRecipeById(Id);
    }
}